<main class="container">

  <section class="hero">
    <h1>{{site.name}}</h1>
    <p class="tagline">{{site.tagline}}</p>
  </section>
  <section class="section" id="contact">
    <h2>Contact</h2>

    <p>
      Email:
      <a href="mailto:{{site.email}}">{{site.email}}</a>
    </p>

    <p>
      <a href="{{site.github}}" target="_blank" rel="noreferrer">GitHub</a>
      {{#if site.linkedin}} | <a href="{{site.linkedin}}" target="_blank" rel="noreferrer">LinkedIn</a>{{/if}}
    </p>
  </section>
  <section class="section" id="education">
    <h2>Education</h2>
    <ul class="project-list">
      {{#each education}}
        <li class="project">
          <div class="project-title">{{title}}</div>
          <div class="project-desc">{{desc}}</div>
        </li>
      {{/each}}
    </ul>
  </section>

  <section class="section" id="coursework">
    <h2>Relevant Coursework</h2>
    <ul class="project-list">
      {{#each coursework}}
        <li class="project">
          <div class="project-title">{{title}}</div>
          <div class="project-desc">{{desc}}</div>
        </li>
      {{/each}}
    </ul>
  </section>

  <section class="section" id="skills">
    <h2>Technical Skills</h2>
    <ul class="project-list">
      {{#each skills}}
        <li class="project skill-card">
          <div class="skill-header">
            <div class="project-title">{{title}}</div>
            <span class="skill-level {{level}}">{{level}}</span>
          </div>
          <div class="project-desc">{{desc}}</div>
        </li>
      {{/each}}
    </ul>
  </section>


  <section class="section" id="projects">
    <h2>Projects</h2>
    <ul class="project-list">
      {{#each projects}}
        <li class="project">
          <div class="project-title">{{title}}</div>
          <div class="project-desc">{{desc}}</div>
        </li>
      {{/each}}
    </ul>
  </section>

  <section class="section" id="certificates">
    <h2>Certificates</h2>
    <ul class="project-list">
      {{#each certificates}}
        <li class="project">
          <div class="project-title">{{title}}</div>
          <div class="project-desc">{{desc}}</div>
        </li>
      {{/each}}
    </ul>
  </section>

  <section class="section" id="leadership">
    <h2>Leadership & Activities</h2>
    <ul class="project-list">
      {{#each leadership}}
        <li class="project">
          <div class="project-title">{{title}}</div>
          <div class="project-desc">{{desc}}</div>
        </li>
      {{/each}}
    </ul>
  </section>

  <section class="section" id="awards">
    <h2>Awards & Competitions</h2>
    <ul class="project-list">
      {{#each awards}}
        <li class="project">
          <div class="project-title">{{title}}</div>
          <div class="project-desc">{{desc}}</div>
        </li>
      {{/each}}
    </ul>
  </section>

</main>
